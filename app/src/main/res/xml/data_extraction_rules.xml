<?xml version="1.0" encoding="utf-8"?>
<!-- Opt out of Android 12+ Auto Backup and device-to-device transfer so the
     Immich API key stored in DataStore is never uploaded to Google Drive or
     migrated to another device without the user explicitly re-pairing. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
